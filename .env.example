# Server local
PORT=3000
NODE_ENV=development
SITE_ORIGIN=http://localhost:3000

# Supabase: kiem tra Project URL trong Dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Dien Secret key (sb_secret_...) hoac service_role legacy.
# Chi dung tren server; khong dua vao frontend, khong commit.
SUPABASE_SECRET_KEY=

# Bucket game hien co la PUBLIC: chi luu game cong khai.
SUPABASE_STORAGE_BUCKET=game
# Tao bucket PRIVATE nay cho game rieng cua nguoi dung.
SUPABASE_PRIVATE_STORAGE_BUCKET=game-private

# Database: chi dien MOT link tu Supabase > Connect > Session pooler > URI.
# Thay [YOUR-PASSWORD] trong URI bang mat khau database (URL-encode ky tu dac biet).
# Mau: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
# Ket noi PostgreSQL chinh cua ung dung. SSL duoc xac minh bang CA Supabase.
DATABASE_URL=
# Bucket công khai cho ảnh/video bài viết
SUPABASE_MEDIA_BUCKET=media

# Reverse proxy CIDRs only; leave empty for direct access. Never use true.
TRUST_PROXY=
# Optional ADDITIONAL exact hostname restriction; per-game endpoints are always required.
GAME_ALLOWED_HOSTS=
# Required for online games: JSON keyed by the exact JAR sha256 from games.sha256.
# No wildcard; match protocol + hostname + port. Empty denies every destination.
# Example: {"<64-hex-sha256>":["tcp://game.example:14444","https://login.example:443"]}
GAME_NETWORK_ENDPOINTS={}

# Optional on Docker; always enabled on Vercel. Private bucket must have Public OFF.
GAME_STORAGE=local
# Vercel: NODE_ENV=production; SITE_ORIGIN=https://your-project.vercel.app
# Vercel DATABASE_URL: Supabase Transaction pooler (6543). Shared pooler 5432 is auto-converted on Vercel.
